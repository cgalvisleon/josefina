{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "node1",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "args": ["-port", "1377", "-http", "3500"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOTOOLCHAIN": "auto"
      },
      "dlvFlags": ["--check-go-version=false"]
    },
    {
      "name": "node2",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "args": ["-port", "1378", "-http", "3501"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOTOOLCHAIN": "auto"
      },
      "dlvFlags": ["--check-go-version=false"]
    },
    {
      "name": "node3",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "args": ["-port", "1379", "-http", "3502"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOTOOLCHAIN": "auto"
      },
      "dlvFlags": ["--check-go-version=false"]
    },
    {
      "name": "client",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/client",
      "args": ["-port", "1377"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOTOOLCHAIN": "auto"
      },
      "dlvFlags": ["--check-go-version=false"]
    },
    {
      "name": "test",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/test",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOTOOLCHAIN": "auto"
      },
      "dlvFlags": ["--check-go-version=false"]
    }
  ],
  "compounds": [
    {
      "name": "cluster",
      "configurations": ["node1", "node2", "node3"],
      "stopAll": true
    },
    {
      "name": "server-client",
      "configurations": ["node1", "client"],
      "stopAll": true
    }
  ]
}
